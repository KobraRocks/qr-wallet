{
  "name": "qr-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-only wallet of scannable QR codes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/icons.mjs",
    "check:budget": "node scripts/check-budget.ts",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "qr": "0.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
